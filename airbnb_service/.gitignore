# Maven output; keep wrapper files and source resources.
/target/
*.class

# Eclipse / Spring Tool Suite metadata.
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans local/build metadata.
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/
/build/
/dist/

# Spring Boot local overrides; never ignore the shared application.yml.
/src/main/resources/application-local*.yml
/src/main/resources/application-local*.yaml
/src/main/resources/application-local*.properties
/src/test/resources/application-local*.yml
/src/test/resources/application-local*.yaml
/src/test/resources/application-local*.properties

# JVM diagnostic output.
hs_err_pid*
replay_pid*
*.hprof

# Runtime uploads generated as UUID&originalFilename by FileImageService.
# Keep bundled category icons and the amenities/seed-danang assets in Git.
/src/main/resources/static/uploads/*&*
